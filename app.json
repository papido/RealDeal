{
  "expo": {
    "name": "RealDeal",
    "slug": "realdeal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/iconImage.png",
    "scheme": "realdeal",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/images/splashImage.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fauzanafk.RealDeal",
      "buildNumber": "1",
      "deploymentTarget": "13.4",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app uses location to show nearby deals and listings.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app uses location to show nearby deals and listings.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to select images for listings and profile pictures.",
        "NSCameraUsageDescription": "This app uses the camera to take photos for listings and profile pictures."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/iconImage.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.fauzanafk.RealDeal",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_MEDIA_IMAGES",
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7187172609991034~6581539305"
        }
      ],
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/images/iconImage.png"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3ee1b712-c40c-4f1f-bf53-c132e5b3cb36"
      }
    },
    "owner": "fauzanafk"
  }
}
